local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function Decode(Data)
    Data = Data:gsub("[^" .. B64 .. "=]", "")
    return (Data:gsub(".", function(C)
        if C == "=" then return "" end
        local V = B64:find(C, 1, true) - 1
        local Bits = ""
        for I = 6, 1, -1 do
            Bits = Bits .. (V % 2^I - V % 2^(I - 1) > 0 and "1" or "0")
        end
        return Bits
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(Byte)
        if #Byte ~= 8 then return "" end
        local V = 0
        for I = 1, 8 do
            if Byte:sub(I, I) == "1" then
                V += 2^(8 - I)
            end
        end
        return string.char(V)
    end))
end

local ImageData = ""
local FileName = "MxssonHub_CleanBackground.png"
local Asset

pcall(function()
    if not isfile(FileName) then
        writefile(FileName, Decode(ImageData))
    end
    if getcustomasset then
        Asset = getcustomasset(FileName)
    elseif getsynasset then
        Asset = getsynasset(FileName)
    end
end)

if not Asset then
    warn("[MxssonHub] Background asset failed")
    return
end

