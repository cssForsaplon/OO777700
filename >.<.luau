local function CreateButton(Text, X)
    local Button = Instance.new("TextButton")
    Button.AnchorPoint = Vector2.new(0.5, 0)
    Button.Position = UDim2.fromScale(X, 0.46)
    Button.Size = UDim2.fromOffset(360, 108)
    Button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Button.BackgroundTransparency = 0.72
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = false
    Button.Font = Enum.Font.Gotham
    Button.Text = Text
    Button.TextColor3 = Color3.fromRGB(245, 245, 245)
    Button.TextSize = 28
    Button.ZIndex = 5
    Button.Parent = Main

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 18)
    Corner.Parent = Button

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(255, 255, 255)
    Stroke.Thickness = 1.4
    Stroke.Transparency = 0.18
    Stroke.Parent = Button

    local Glow = Instance.new("UIStroke")
    Glow.Color = Color3.fromRGB(255, 255, 255)
    Glow.Thickness = 5
    Glow.Transparency = 1
    Glow.Parent = Button

    local Scale = Instance.new("UIScale")
    Scale.Parent = Button

    Button.MouseEnter:Connect(function()
        TweenService:Create(Scale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1.025}):Play()
        TweenService:Create(Button, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.58}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.18), {Transparency = 0}):Play()
        TweenService:Create(Glow, TweenInfo.new(0.18), {Transparency = 0.72}):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(Scale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
        TweenService:Create(Button, TweenInfo.new(0.18), {BackgroundTransparency = 0.72}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.18), {Transparency = 0.18}):Play()
        TweenService:Create(Glow, TweenInfo.new(0.18), {Transparency = 1}):Play()
    end)

    Button.MouseButton1Down:Connect(function()
        TweenService:Create(Scale, TweenInfo.new(0.08), {Scale = 0.985}):Play()
    end)

    Button.MouseButton1Up:Connect(function()
        TweenService:Create(Scale, TweenInfo.new(0.1), {Scale = 1.025}):Play()
    end)

    return Button
end

local PvPButton = CreateButton("PvP", 0.265)
local FarmButton = CreateButton("Farm", 0.735)

local Busy = false

local function Execute(Url)
    if Busy or not Url or Url == "" or Url:find("YOUR_") then
        return
    end

    Busy = true

    local Fade = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    TweenService:Create(Overlay, Fade, {BackgroundTransparency = 1}):Play()
    TweenService:Create(Title, Fade, {TextTransparency = 1}):Play()
    TweenService:Create(Sub, Fade, {TextTransparency = 1}):Play()
    TweenService:Create(Line, Fade, {BackgroundTransparency = 1}):Play()
    TweenService:Create(PvPButton, Fade, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
    TweenService:Create(FarmButton, Fade, {BackgroundTransparency = 1, TextTransparency = 1}):Play()

    task.wait(0.31)
    Gui:Destroy()

    local Ok, Result = pcall(function()
        return loadstring(game:HttpGet(Url))()
    end)

    if not Ok then
        warn("[MxssonHub] Failed to load selected mode: " .. tostring(Result))
    end
end

PvPButton.MouseButton1Click:Connect(function()
    Execute(PvPUrl)
end)

FarmButton.MouseButton1Click:Connect(function()
    Execute(FarmUrl)
end)
